{
  "name": "temmejs",
  "type": "module",
  "version": "1.0.8",
  "packageManager": "pnpm@12.15.0",
  "description": "Temme (or Emmet in reverse) is to javascript what Emmet is to HTML and CSS, with no doubts, Emmet saved us from the headache of working with HTML and CSS, and now, Temme is doing Javascript the same favour too.",
  "author": "EOussama",
  "license": "MIT",
  "funding": "https://github.com/sponsors/eoussama",
  "homepage": "https://github.com/eoussama/temme.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eoussama/temme.js.git"
  },
  "bugs": {
    "url": "https://github.com/eoussama/temme.js/issues"
  },
  "keywords": [
    "typescript",
    "javascript",
    "javascript-library",
    "dom",
    "emmet"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/temme.d.mts",
        "default": "./dist/temme.mjs"
      },
      "require": {
        "types": "./dist/temme.d.cts",
        "default": "./dist/temme.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/temme.cjs",
  "module": "./dist/temme.mjs",
  "unpkg": "./dist/temme.umd.js",
  "jsdelivr": "./dist/temme.umd.js",
  "types": "./dist/temme.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:site": "node scripts/build-site.mjs",
    "dev": "tsdown --watch",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "dx lint",
    "lint:fix": "dx fix",
    "test": "vitest run --project unit --coverage",
    "test:watch": "vitest --project unit",
    "test:smoke": "vitest run --project smoke",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "check": "pnpm audit && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:smoke && pnpm build:site && pnpm test:e2e && pnpm test:mutation",
    "prepack": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@eoussama/core": "^0.1.2"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eoussama/dx": "^0.1.3",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "rolldown": "^1.2.15",
    "tsdown": "^0.23.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
